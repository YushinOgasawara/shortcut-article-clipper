# iPhoneショートカット認証用トークン（任意の文字列）
SECRET_TOKEN=your-random-secret-string

# Gemini API Key
# 取得方法: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxx

# Notion API Key (Internal Integration Token)
# 取得方法: https://www.notion.so/my-integrations
NOTION_API_KEY=secret_xxxxxxxxxxxxx

# Notion Database ID
# 取得方法: NotionページのURLから抽出
# 例: https://www.notion.so/workspace/DATABASE_ID?v=...
# DATABASE_IDの部分（32文字のハイフン区切り文字列）
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
